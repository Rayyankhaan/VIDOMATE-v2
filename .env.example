# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional banner-only ad network configuration (no interstitials/full-screen ads)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_MID=
NEXT_PUBLIC_AD_SLOT_BOTTOM=

# Optional YouTube enhancements
YOUTUBE_API_KEY=
YOUTUBE_COOKIES=
COBALT_API_URL=
COBALT_API_KEY=

# Optional Meta (Instagram / Facebook) oEmbed token
META_OEMBED_ACCESS_TOKEN=

# Optional Pinterest API v5 token
PINTEREST_ACCESS_TOKEN=

# Optional Reddit OAuth app credentials
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_CONTACT_USERNAME=vidomate

# Optional rate limiting (Upstash Redis) and signing
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=vidomate

# Optional Supabase (contact form & anonymous stats)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_ANALYSIS_HISTORY=false
